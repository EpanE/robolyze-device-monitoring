# Copy to .env (project root, one level above dashboard/) and fill in.
# config.py reads this file directly rather than os.environ: keys like USERNAME
# collide with real OS environment variables on Windows.

# Required — the dashboard refuses to start without these.
TAILSCALE_IP_ADDRESS="100.110.189.87"
USERNAME="rasp"
SSH_PASSWORD=""

# Optional — defaults shown.
# Loopback by default: reaching HOST:PORT is enough to open an SSH session to the truck,
# so set 0.0.0.0 only when you actually want others on the LAN to reach this — and set
# DASHBOARD_PASSWORD when you do.
HOST="127.0.0.1"
PORT="5000"
CONFIRMED_MIN_CONFIDENCE="0.75"

# Optional. Empty = no login (fine on loopback). Set it and every route asks for HTTP
# Basic credentials; any username works, this password is what is checked.
DASHBOARD_PASSWORD=""

# Verbosity of dashboard/logs/dashboard.log. INFO logs startup plus every error with its
# traceback; ERROR drops the startup line; DEBUG adds paramiko/werkzeug's own chatter.
# An unrecognised value falls back to INFO rather than refusing to start.
LOG_LEVEL="INFO"
